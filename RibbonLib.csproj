<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Built for .NET 10 and for .NET 8: hosts that have not moved yet can still use the control.
         Nothing here is 10-only, and the designer assembly follows suit. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Dwain.RibbonLib</PackageId>
	<Version>1.0.8-net10</Version>
    <Title>RibbonLib for .NET 8 or 10</Title>
    <Authors>Dwain Snickles;Jose Menendez Poo</Authors>
    <Copyright>MS-PL. Original ribbon code (c) Jose Menendez Poo and the RibbonWinForms contributors.</Copyright>
    <!-- First sentence is the tagline used for the repository description, so the package page and
         the GitHub sidebar say the same thing. -->
    <Description>Office-style ribbon for Windows Forms, ported to .NET 10 with working out-of-process designer support. A fork of RibbonWinForms. It also builds for .NET 8. Tabs, panels, buttons, combo boxes, item groups, button lists, the orb menu, contexts and the quick access toolbar are all editable in the designer, and no design-time tooling is needed at runtime.</Description>
    <!-- Hyphenated because nuget.org splits tags on spaces and semicolons: "Windows Ribbon" has to be
         windows-ribbon to survive as one tag. The same words are used as GitHub topics. -->
    <PackageTags>winforms;ribbon;ribbon-framework;ribbon-control;ribbon-tools;windows-ribbon;win-ribbon;office-ribbon;windows-forms;winforms-designer;gui;dotnet;net8;net10;windowsribbon</PackageTags>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/DwainSnickles/RibbonWinForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DwainSnickles/RibbonWinForms.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Clicking the orb in the designer now opens the orb menu on the design surface. The real drop-down is a top-level window the designer process cannot keep on screen, so the designer paints the menu itself - menu, recent and option items with their icons, row highlighting, click-to-select, and the "+" glyphs that add new entries - the same approach the panel "Add Control" menu already used. The runtime API is unchanged from 1.0.5-net10.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- The design-time half lives in its own assembly, so nothing here mentions design-tools types. -->
    <Compile Remove="RibbonLib.Design\**" />
    <None Remove="RibbonLib.Design\**" />
    <!-- Sample projects under samples/ have their own project files; without this their sources
         would be globbed into the library as well and fail to compile here. -->
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <EmbeddedResource Remove="samples\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The designers are compiled against this assembly, so it may reach their internals. -->
    <InternalsVisibleTo Include="RibbonLib.Design" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The design half is added to the package during packing, not by an item declared above:
         items are evaluated before any target runs, so a declared path would be missing on a cold
         build. It ships in tools/, next to the assembly and never in lib/, so it is not a
         compile-time reference for the consuming app. -->
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);AddDesignAssemblyToPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="AddDesignAssemblyToPackage">
    <!-- A plain `dotnet pack` builds the designer first, so the package cannot ship a stale one.
         Packing with NoBuild (the publish workflow) expects both projects to be built already.
         This target runs once per target framework, and the designer is built for that same
         framework: a net8 host is served by a net8 design server, so it needs a net8 designer. -->
    <MSBuild Projects="RibbonLib.Design\RibbonLib.Design.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);Version=$(Version);TargetFramework=$(TargetFramework)"
             Condition="'$(NoBuild)' != 'true'" />
    <ItemGroup>
      <!-- In lib/[tfm]/Design/WinForms/Server, the folder Windows Forms loads server-side designers
           from. Parked in lib/[tfm] the design assembly is a compile and runtime reference of every
           consuming app, and the design server - which reads the Design folder - never loads it, so
           the ribbon is hosted as a bare component: no designer, no design-time clicks. -->
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\RibbonLib.Design\bin\$(Configuration)\$(TargetFramework)\RibbonLib.Design.dll">
        <PackagePath>lib\$(TargetFramework)$(TargetPlatformVersion)\Design\WinForms\Server\</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>