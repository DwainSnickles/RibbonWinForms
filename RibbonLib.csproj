<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Built for .NET 10 and for .NET 8: hosts that have not moved yet can still use the control.
         Nothing here is 10-only, and the designer assembly follows suit. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Dwain.RibbonLib</PackageId>
	<Version>1.0.32</Version>
    <Title>RibbonLib for .NET 8 or 10</Title>
    <Authors>Dwain Snickles;Jose Menendez Poo;harborsiem</Authors>
    <Copyright>MS-PL. Original ribbon code (c) Jose Menendez Poo, the RibbonWinForms contributors and harborsiem (WindowsRibbon).</Copyright>
    <!-- First sentence is the tagline used for the repository description, so the package page and
         the GitHub sidebar say the same thing. -->
    <Description>Office-style ribbon for Windows Forms, ported to .NET 10 with working out-of-process designer support. A fork of WindowsRibbon (https://github.com/harborsiem/WindowsRibbon) and RibbonWinForms - great work by harborsiem and Jose Menendez Poo. It also builds for .NET 8. Tabs, panels, buttons, combo boxes, item groups, button lists, the orb menu, contexts and the quick access toolbar are all editable in the designer, and no design-time tooling is needed at runtime.</Description>
    <!-- Hyphenated because nuget.org splits tags on spaces and semicolons: "Windows Ribbon" has to be
         windows-ribbon to survive as one tag. The same words are used as GitHub topics. -->
    <PackageTags>winforms;ribbon;ribbon-framework;ribbon-control;ribbon-tools;windows-ribbon;win-ribbon;office-ribbon;windows-forms;winforms-designer;gui;dotnet;net8;net10;windowsribbon;microsoft-ribbon;ribbon-ui;winribbon</PackageTags>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/DwainSnickles/RibbonWinForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DwainSnickles/RibbonWinForms.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Deleting an orb entry no longer takes the Windows Forms designer down. The delete went through the designer host with an unchecked transaction commit and read the ribbon's drop-down without checking, so a host that hands back no transaction threw a null reference out of the design surface's mouse handling and the design tools server reported it as a modal error; the transaction is now optional, the entry still leaves its collection when the host path fails, a failure is logged to RibbonLibDesign.log instead of escaping, and the design surface's click guard catches anything left. Same code as 1.0.31 otherwise. README fix: the screenshot under the fork description now loads on nuget.org (it used a relative docs/ribbon.png path, which the package does not contain) and the version badge shows the newest release instead of the newest prerelease. Code is unchanged from 1.0.30. Orb menu fixes from 1.0.29: The design surface draws the orb menu in two panes again - menu items on the left, the recent-items caption and list plus the option buttons on the right - instead of one list, while keeping the content-sized layout, the placeholder captions for entries with no text and a single row when a collection holds the same item more than once. At runtime the drop-down only laid its panes and items out when it already had a window handle, but the call that sizes it (OnOpening) runs before the handle exists, so it opened at its default size with empty panes and items at no position; it now measures through the desktop DC when there is no handle and lays out again when the handle is created. Every orb entry, separators included, still opens the same context menu on left or right click, and Delete removes the entry from its collection. Runtime behaviour is otherwise unchanged.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- The design-time half lives in its own assembly, so nothing here mentions design-tools types. -->
    <Compile Remove="RibbonLib.Design\**" />
    <None Remove="RibbonLib.Design\**" />
    <!-- Sample projects under samples/ have their own project files; without this their sources
         would be globbed into the library as well and fail to compile here. -->
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <EmbeddedResource Remove="samples\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The designers are compiled against this assembly, so it may reach their internals. -->
    <InternalsVisibleTo Include="RibbonLib.Design" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The design half is added to the package during packing, not by an item declared above:
         items are evaluated before any target runs, so a declared path would be missing on a cold
         build. It ships in tools/, next to the assembly and never in lib/, so it is not a
         compile-time reference for the consuming app. -->
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);AddDesignAssemblyToPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="AddDesignAssemblyToPackage">
    <!-- A plain `dotnet pack` builds the designer first, so the package cannot ship a stale one.
         Packing with NoBuild (the publish workflow) expects both projects to be built already.
         This target runs once per target framework, and the designer is built for that same
         framework: a net8 host is served by a net8 design server, so it needs a net8 designer. -->
    <MSBuild Projects="RibbonLib.Design\RibbonLib.Design.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);Version=$(Version);TargetFramework=$(TargetFramework);RibbonLibDesignBuild=true"
             Condition="'$(NoBuild)' != 'true'" />
    <ItemGroup>
      <!-- In lib/[tfm]/Design/WinForms/Server, the folder Windows Forms loads server-side designers
           from. Parked in lib/[tfm] the design assembly is a compile and runtime reference of every
           consuming app, and the design server - which reads the Design folder - never loads it, so
           the ribbon is hosted as a bare component: no designer, no design-time clicks. -->
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\RibbonLib.Design\bin\$(Configuration)\$(TargetFramework)\RibbonLib.Design.dll">
        <PackagePath>lib\$(TargetFramework)$(TargetPlatformVersion)\Design\WinForms\Server\</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <!-- A plain `dotnet build` must also produce the designer: the out-of-process WinForms design
       server loads <Assembly>.Design.dll from beside the control assembly (or from the consuming
       app's output). Without it the ribbon silently fails to materialize on the design surface.
       Skipped during pack (AddDesignAssemblyToPackage already builds it) and during design-time
       builds of this project itself to avoid recursion. -->
  <Target Name="CopyDesignAssemblyToOutput" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RibbonLibDesignBuild)' != 'true' and '$(TargetFramework)' != ''">
    <!-- RibbonLibDesignBuild flows through the Design project's ProjectReference back into this
         project, so the RibbonLib build that Design depends on skips this target - no recursion. -->
    <MSBuild Projects="RibbonLib.Design\RibbonLib.Design.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);Version=$(Version);TargetFramework=$(TargetFramework);RibbonLibDesignBuild=true" />
    <ItemGroup>
      <DesignDll Include="$(MSBuildProjectDirectory)\RibbonLib.Design\bin\$(Configuration)\$(TargetFramework)\RibbonLib.Design.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DesignDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DesignDll->'$(MSBuildProjectDirectory)\RibbonLib.Design\bin\$(Configuration)\$(TargetFramework)\RibbonLib.Design.pdb')"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"
          Condition="Exists('%(DesignDll.FullPath).pdb')" />
  </Target>

</Project>