<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- One designer build per framework the library ships for, so a net8 host gets a designer the
         net8 design server can load. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RibbonLib.Design</AssemblyName>
    <RootNamespace>RibbonLib</RootNamespace>
    <!-- Design-time only: it is never a compile reference of an application and never packed as one. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the design server ships with Visual Studio, never with this library. -->
    <PackageReference Include="Microsoft.WinForms.Designer.SDK" Version="1.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RibbonLib.csproj" />
  </ItemGroup>

</Project>
